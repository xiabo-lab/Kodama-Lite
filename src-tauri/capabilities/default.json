{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions: invoke app commands, listen to bus events, open external links, toggle full screen from the settings menu, and the scoped outbound hosts the JS-side network/lyrics subsystem is allowed to reach.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://music.youtube.com/*" },
        { "url": "https://i.ytimg.com/*" },
        { "url": "https://yt3.ggpht.com/*" },
        { "url": "https://yt3.googleusercontent.com/*" },
        { "url": "https://lh3.googleusercontent.com/*" },
        { "url": "https://lrclib.net/*" },
        { "url": "http://mobilecdn.kugou.com/*" },
        { "url": "http://krcs.kugou.com/*" },
        { "url": "http://lyrics.kugou.com/*" },
        { "url": "https://music.163.com/*" },
        { "url": "https://apic-desktop.musixmatch.com/*" },
        { "url": "https://c.y.qq.com/*" },
        { "url": "https://genius.com/*" }
      ]
    }
  ]
}
